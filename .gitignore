# Environment variables and secrets
.env
.env.*
!.env.example

# Local application configuration
application-local.properties
application-local.yml
application-local.yaml

# Log files
*.log
logs/

# Temporary and OS files
.DS_Store
Thumbs.db

# Local test dependencies and generated reports
verification/**/node_modules/
verification/**/reports/
verification/**/classpath.txt
verification/**/evidence.txt
verification/**/run.log
verification/**/apifox.log

# DEV-030: keep machine-specific credentials out of the first commit.
# Copy application-example.properties to application.properties on a new checkout.
/src/main/resources/application.properties

# Local verification dependency cache and runtime state.
/verification/apifox/cli/store/
/verification/apifox/runtime-local.json
/verification/apifox/format-probe.json

# Generated verification evidence and test reports (keep authored scripts/docs).
/verification/**/*.txt
/verification/**/*.xml
/verification/**/*.dumpstream
/verification/**/*-surefire/
/verification/**/artifact-check.json

# Historical source backups generated during verification
verification/**/before/
verification/**/before-src/
# Local historical verification workspace (kept on disk, not required to run tests).
/verification/
/DEV-027_RESERVATION_CANCEL_VERIFICATION.md
/DEV-029_FULL_REGRESSION_REPORT.md
/RESERVATION_IDENTITY_VERIFICATION.md

# Private keys, database dumps and heap dumps must not enter public source.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.sql.gz
*.dump
*.hprof
*.bak

# Machine-specific Spring overrides; keep reviewed examples in version control.
/application.properties
/application.yml
/application.yaml
/config/application.properties
/config/application.yml
/config/application.yaml
/src/main/resources/application.yml
/src/main/resources/application.yaml
